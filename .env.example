# Configuración Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=marketing-ai-super-secret-key-2026

# Base de Datos (PostgreSQL en Docker o SQLite en local)
DATABASE_URL=postgresql://marketing_user:marketing_secret_pass@db:5432/marketing_db
# Para SQLite local: DATABASE_URL=sqlite:///marketing.db

# Configuración PostgreSQL (para docker-compose)
POSTGRES_USER=marketing_user
POSTGRES_PASSWORD=marketing_secret_pass
POSTGRES_DB=marketing_db

# Almacenamiento
UPLOAD_FOLDER=app/static/uploads
GENERATED_FOLDER=app/static/generated
MAX_CONTENT_LENGTH=16777216
